  "integrationScenarios": [
    {
      "id": "I01",
      "case": "Double FINISH_PRESENTATION / watchdog / same turnEndId",
      "expectation": "Only one heal and one turn consumption"
    },
    {
      "id": "I02",
      "case": "Qualified attack on turn N, PREPARE on N+1",
      "expectation": "Suppression does not carry; the preparation turn heals"
    },
    {
      "id": "I03",
      "case": "Stage9-4 temporary that remaining, NEXT_BATTLE to9-5",
      "expectation": "Temporary cards removed; Stage9-5 creates zero support instances"
    },
    {
      "id": "I04",
      "case": "No that in hand but a permanent that exists",
      "expectation": "No conditional frost that supply"
    },
    {
      "id": "I05",
      "case": "Normal frost consumed by accepted INVALID_CORE submission",
      "expectation": "Frost remains shattered; no recovery via recycle or load"
    },
    {
      "id": "I06",
      "case": "No Stage9 target permanent cards obtained",
      "expectation": "No rescue; boss entry allowed; a real defeat is permitted"
    },
    {
      "id": "I07",
      "case": "9-1 reward eligibility",
      "expectation": "New permanent what/whether eligible before boss, preserving rarity and no guaranteed offers"
    },
    {
      "id": "I08",
      "case": "Load old0.8.1 completed run",
      "expectation": "STAGE8_END and old version balance retained"
    },
    {
      "id": "I09",
      "case": "Load or cancel published new0.9 reward",
      "expectation": "Same offer candidates, prices and RNG state; no duplicate gain"
    },
    {
      "id": "I10",
      "case": "0.9 golem phase definitions",
      "expectation": "Three 280HP phases, total840; no carry-over excess"
    },
    {
      "id": "I11",
      "case": "All rarity classes eligible, first unrestricted rune candidate",
      "expectation": "RARE mass9/300, not an unconditional combat acquisition probability"
    },
    {
      "id": "I12",
      "case": "VALID_WITH_ISSUES outside valid target vs issue invalidating target",
      "expectation": "Use target evidence validity; do not conflate all partial-valid attacks"
    }
  ]
}